---
import '../styles/tokens.css';
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Hutch is an iPhone app for keeping track of everything you own, end-to-end encrypted so no one sees your inventory but you.' } = Astro.props;
const pageTitle = title ? `${title} · Hutch` : 'Hutch · Your things, privately kept';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Hutch home">hutch</a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <nav aria-label="Footer">
        <a href="/privacy">Privacy</a>
        <a href="/support">Support</a>
      </nav>
      <p>No analytics. No trackers. No cookies.</p>
    </footer>
  </body>
</html>
