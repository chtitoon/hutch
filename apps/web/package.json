{
  "name": "hutch-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm ci",
    "tokens": "node tokens.mjs",
    "build": "astro build",
    "design:lint": "npm run design:lint:md && npm run design:lint:css",
    "design:lint:md": "node design-lint.mjs",
    "design:lint:css": "node check-css.mjs",
    "web:build": "performance lint && node tokens.mjs --check && node og.mjs --check && astro build && html-validate \"dist/**/*.html\" && node check-links.mjs && performance check",
    "test": "npm run design:lint && npm run web:build",
    "run": "astro dev",
    "og": "node og.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@google/design.md": "0.4.0",
    "astro": "7.3.5",
    "css-select": "6.0.0",
    "css-what": "7.0.0",
    "harfbuzzjs": "1.6.3",
    "html-validate": "11.16.0",
    "htmlparser2": "12.0.0",
    "performance-md": "github:chtitoon/performance.md#4dfac9e161d9249e4c5e5d52df7ab14023fcb2fd",
    "playwright-core": "1.56.1",
    "postcss": "8.5.30",
    "subset-font": "2.9.0",
    "yaml": "2.9.1"
  }
}
