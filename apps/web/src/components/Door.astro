---
// Line drawings of a door for the "Where we’re heading" cards: closed, ajar (lend), open with an arrow (sell).
interface Props {
  state: 'closed' | 'ajar' | 'out';
}

const { state } = Astro.props;
---

<svg class="door" width="56" height="72" viewBox="0 0 56 72" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true">
  <rect x="4" y="4" width="48" height="64" rx="3" />
  {state === 'closed' && (
    <>
      <rect x="10" y="10" width="36" height="58" />
      <circle class="door-knob" cx="39" cy="40" r="2" />
    </>
  )}
  {state === 'ajar' && (
    <>
      <path d="M10 10h36v58H10z" stroke-dasharray="3 4" />
      <path class="door-leaf" d="M10 10l20 6v58l-20-6z" />
      <path d="M40 30h4M40 40h4M40 50h4" />
    </>
  )}
  {state === 'out' && (
    <>
      <path d="M10 10l-6 4v52l6 2z" />
      <path d="M22 39h20M35 32l7 7-7 7" />
    </>
  )}
</svg>
