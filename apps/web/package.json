{
  "name": "hutch-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm ci",
    "tokens": "node tokens.mjs",
    "build": "astro build",
    "test": "node tokens.mjs --check && node og.mjs --check && astro build && html-validate \"dist/**/*.html\" && node check-links.mjs",
    "run": "astro dev",
    "og": "node og.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "astro": "7.3.5",
    "html-validate": "11.16.0",
    "playwright-core": "1.56.1"
  }
}
