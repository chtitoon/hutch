# macOS
.DS_Store

# Xcode — the project is generated by XcodeGen from apps/ios/project.yml, never committed
apps/ios/*.xcodeproj/
apps/ios/*.xcworkspace/
# The product catalog and its 100 MB model, built by `make catalog` (X5), never committed
apps/ios/Hutch/Catalog/
xcuserdata/
DerivedData/
build/
*.xcresult

# Swift Package Manager
.build/
.swiftpm/
Package.resolved.bak

