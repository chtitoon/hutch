---
import Base from '../layouts/Base.astro';
import AppStoreLink from '../components/AppStoreLink.astro';
import PhoneMockup from '../components/PhoneMockup.astro';
import StageIcon from '../components/StageIcon.astro';

const points = [
  { title: 'Encrypted on your iPhone', body: 'Items, photos, notes and locations are encrypted the moment you add them, before they’re stored or synced.' },
  { title: 'Only you can unlock it', body: 'Your inventory stays locked to everyone but you. It’s yours alone.' },
  { title: 'Nothing watching', body: 'No ads, no analytics, no trackers. Not in the app, not on this page.' },
];

const stages = [
  { icon: 'private', badge: 'At launch', title: 'Behind closed doors', body: 'Snap it, name it, say where it lives. Everything you add is private by default.' },
  { icon: 'lend', badge: 'Planned', title: 'A few things on the shelf', body: 'Choose what to lend to people you trust: the ladder, the tent, the pasta maker…' },
  { icon: 'sell', badge: 'Planned', title: 'Out the door', body: 'When it’s time, sell what you no longer need straight from your inventory.' },
] as const;
---

<Base>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Home inventory for iPhone</p>
      <h1 class="hero-title">Your things, privately kept.</h1>
      <p class="lede">Remember what you own and where it lives, so you can find it fast, and one day lend or sell it. Encrypted on your iPhone, for your eyes only.</p>
      <div class="hero-actions">
        <AppStoreLink />
        <a class="text-link" href="#privacy">How it stays private →</a>
      </div>
    </div>
    <div class="hero-art">
      <PhoneMockup />
    </div>
  </section>

  <section id="privacy" class="band">
    <div class="container band-inner">
      <div class="band-head">
        <h2 class="band-title">Built so only you can look.</h2>
        <p class="band-lede">An inventory is a map of your home. That’s exactly the kind of thing that shouldn’t sit readable on someone else’s server.</p>
      </div>
      <ol class="points">
        {points.map((point, i) => (
          <li>
            <span class="point-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{point.title}</h3>
            <p>{point.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="grows container">
    <div class="section-head">
      <p class="eyebrow">Where we’re heading</p>
      <h2 class="section-title">Starts private. Opens only when you do.</h2>
    </div>
    <div class="cards">
      {stages.map((stage) => (
        <article class:list={['card', stage.badge === 'At launch' ? 'card--solid' : 'card--planned']}>
          <div class="card-meta">
            <StageIcon stage={stage.icon} />
            <span class:list={['badge', stage.badge === 'At launch' ? 'badge--launch' : 'badge--planned']}>{stage.badge}</span>
          </div>
          <h3>{stage.title}</h3>
          <p>{stage.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="container closing-wrap">
    <div class="closing">
      <h2 class="closing-title">Private until you lend it. Yours until you sell it.</h2>
      <AppStoreLink label="Coming to iPhone" />
    </div>
  </section>
</Base>
