{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(npm run *)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npx performance *)",
      "Bash(node fonts.mjs)",
      "Bash(node fonts.mjs *)",
      "Bash(xcodegen *)",
      "Bash(xcodebuild *)",
      "Bash(xcrun simctl *)",
      "Bash(swift build *)",
      "Bash(swift test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git push -u origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr comment *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.p8)"
    ]
  }
}
