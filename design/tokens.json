{
  "$description": "Hutch design tokens: the single source of truth for both apps. Status: proposed (D15, Oct 2026). Forest, warm grey and brass, from the landing-page design.",
  "color": {
    "ink": { "$type": "color", "$value": "#1B2420", "$description": "Primary text, the wordmark, dark pills." },
    "ink-muted": { "$type": "color", "$value": "#4A554F", "$description": "Body copy and secondary text on light surfaces." },
    "ink-subtle": { "$type": "color", "$value": "#55605A", "$description": "Captions, metadata, footer text, quiet line drawings." },
    "background": { "$type": "color", "$value": "#F3F1EC", "$description": "Page and app background: warm off-white." },
    "surface": { "$type": "color", "$value": "#FFFFFF", "$description": "Raised cards and screens on the background." },
    "surface-sunken": { "$type": "color", "$value": "#E8E5DD", "$description": "Recessed panels, neutral badges, the closing card." },
    "border": { "$type": "color", "$value": "#DEDAD0", "$description": "Hairlines, dividers, card edges." },
    "border-dashed": { "$type": "color", "$value": "#C9C5BA", "$description": "Dashed outlines for things that are planned but not built." },
    "deep": { "$type": "color", "$value": "#1F3A31", "$description": "Forest. Dark bands such as the privacy section." },
    "on-deep": { "$type": "color", "$value": "#E9EEE9", "$description": "Headings and primary text on deep." },
    "on-deep-muted": { "$type": "color", "$value": "#B4C3BA", "$description": "Body text on deep." },
    "deep-rule": { "$type": "color", "$value": "#3A5A4E", "$description": "Dividers on deep." },
    "accent": { "$type": "color", "$value": "#D4A24C", "$description": "Brass. Fills and markers only (dots, numerals on deep); never text on a light surface." },
    "sage": { "$type": "color", "$value": "#3E7A62", "$description": "Small labels and eyebrows, link hover, the focus ring." },
    "sage-tint": { "$type": "color", "$value": "#E2EDE7", "$description": "Background of positive badges." },
    "on-sage-tint": { "$type": "color", "$value": "#2C5A48", "$description": "Text on sage-tint." }
  },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "ui-sans-serif", "system-ui", "sans-serif"], "$description": "Headings and the wordmark. Weights 500 and 700; optical sizing on." },
    "text": { "$type": "fontFamily", "$value": ["Instrument Sans", "ui-sans-serif", "system-ui", "-apple-system", "sans-serif"], "$description": "Body, labels, buttons. Weights 400, 500 and 600." }
  },
  "font-weight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "12px", "$description": "Inputs, thumbnails." },
    "md": { "$type": "dimension", "$value": "24px", "$description": "Cards." },
    "lg": { "$type": "dimension", "$value": "32px", "$description": "Large panels." },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Pills and badges." }
  },
  "space": {
    "$description": "4px-based scale; the name is the multiple of 4px.",
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "7": { "$type": "dimension", "$value": "28px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "14": { "$type": "dimension", "$value": "56px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "22": { "$type": "dimension", "$value": "88px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "28": { "$type": "dimension", "$value": "112px" },
    "30": { "$type": "dimension", "$value": "120px" }
  }
}
