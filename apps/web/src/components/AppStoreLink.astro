---
// The one place the App Store link lives. Until Hutch is listed, it's a status pill.
interface Props {
  label?: string;
}

const { label = 'Coming to the App Store' } = Astro.props;
const appStoreUrl: string | undefined = undefined;
---

{appStoreUrl ? (
  <a class="pill" href={appStoreUrl}>Download on the App Store</a>
) : (
  <p class="pill">{label}</p>
)}
